    protected static function populateIa10Data($state, callable $set)
    {
        $reg = AssessmentRegistration::with([
            'scheme.competencyUnits.workGroup',
            'candidate',
            'assessor'
        ])->find($state);

        if ($reg) {
            $set('fria10_data.header.certification_scheme', $reg->scheme?->name);
