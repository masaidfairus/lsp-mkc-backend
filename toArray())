            $set('fria07_data.header.assessment_date', now()->format('Y-m-d'));

            if ($reg->scheme) {
                $units = $reg->scheme->competencyUnits;
                $grouped = $units->groupBy(fn($u) => $u->workGroup?->name ?? 'Lainnya');

